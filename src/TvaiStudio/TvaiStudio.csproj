<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Project">
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>tvaistudio</AssemblyName>
    <RootNamespace>TvaiStudio</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
  </PropertyGroup>

  <!-- 单文件自包含发布参数只在 Release 生效：否则普通 dotnet build 也会按 RID 自包含构建，
       既拖慢本地与 CI 的构建，也会顺带关掉 Debug 的 PDB 生成。WinForms 不能裁剪。 -->
  <PropertyGroup Label="Publish" Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!--
    第三方内核：由 tools/sync-tvai-core.ps1 同步而来，逐文件 SHA-256 记录在
    third_party/videoenhancer-core/MANIFEST.json。不要直接编辑这些文件——
    在来源仓库修改后重跑同步脚本。
  -->
  <ItemGroup Label="Synced third-party core (do not edit in place)">
    <Compile Include="..\..\third_party\videoenhancer-core\*.cs" />
    <EmbeddedResource Include="..\..\third_party\videoenhancer-core\PresetTemplate.json" />
  </ItemGroup>

</Project>
